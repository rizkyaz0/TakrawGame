# Salin ke .env.local (lokal) dan isi juga di Vercel: Project Settings > Environment Variables.
# Keduanya aman ada di klien (kunci publik); JANGAN taruh service_role key di sini.
VITE_SUPABASE_URL=https://uwbjtmywvknjtrnkfzay.supabase.co
# Dashboard Supabase > Project Settings > API Keys > "Publishable key" (sb_publishable_...) atau anon key
VITE_SUPABASE_ANON_KEY=
# Server perantara mabar (O2). Kosong = pakai PeerJS publik seperti sebelumnya.
# Lokal: ws://localhost:8787 (jalankan `npm run dev` di folder server). Produksi: wss://<worker>.workers.dev
VITE_ONLINE_URL=
